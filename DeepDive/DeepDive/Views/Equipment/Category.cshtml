@model List<dynamic>
<h1>@ViewBag.Category</h1>
<div class="row row-cols-2 g-3">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card bg-b">
                <img src="@item.ImageUrl" class="card-img-top" />
                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <p>@item.Price kr.</p>
                    <a asp-action="Details" asp-route-category="@ViewBag.Category" asp-route-id="@item.Id" class="btn btn-primary">Se vare</a>
                </div>
            </div>
        </div>
    }
</div>