@using DeepDive.ViewModels;
@model AllEquipmentViewData

@{
    string action = ViewBag.Action ?? string.Empty;

    string title = action switch
    {
        "BCD" => "BCD",
        "DivingSuits" => "Dykkerdragter",
        "Finns" => "Finner",
        "Mask_Snorkel" => "Maske & Snorkel",
        "RegulatorSet" => "RegulatorSæt",
        "Tank" => "Tank",
        _ => ""
    };
}

<h1>@title</h1>

<div class="row row-cols-2 row-cols-md-3">
    @foreach (var equipment in Model.bcds)
    {
        <div class="col">
        <a asp-controller="SpecificEquipment" asp-action="SpecificBCD" asp-route-id="@equipment.BCDId" class="text-decoration-none">
                <div class="card bg-b EquipmentCard">
                    <div class="card-body">
                        <img src="~/IMGs/Oceanic-Oceanpro-BCD-.png" alt="BCD Vest" />
                        <h5 class="product-title">@equipment.Model</h5>
                        <h6>@equipment.Brand</h6>
                        <h6>Størrelse: @string.Join(", ", equipment.Size)</h6>
                        <p class="price">@equipment.Price kr. pr. dag</p>
                        <span class="btn btn-primary">Se produkt</span>
                    </div>
                </div>
            </a>
            </div>
        
    }
</div>

<div class="row row-cols-2 row-cols-md-3">
    @foreach (var equipment in Model.divingSuits)
    {
        <div class="col">
        <a asp-controller="SpecificEquipment" asp-action="SpecificDivingSuits" asp-route-id="@equipment.DivingSuitsId" class="text-decoration-none">
         
                <div class="card bg-b EquipmentCard">
                    <div class="card-body">
                        <img src="~/IMGs/Suit.webp" alt="BCD Vest" />
                        <h5 class="product-title">@equipment.Model</h5>
                        <h6>@equipment.Brand</h6>
                        <h6>Størrelse: @string.Join(", ", equipment.Size)</h6>
                        <h6>Type: @equipment.Type · @equipment.Thickness mm</h6>
                        <h6>Køn: @string.Join(", ", equipment.Gender)</h6>
                        <p class="price">@equipment.Price kr. pr. dag</p>
                        <span class="btn btn-primary">Se produkt</span>
                    </div>
                </div>
            </a>
            </div>
   
    }
</div>

