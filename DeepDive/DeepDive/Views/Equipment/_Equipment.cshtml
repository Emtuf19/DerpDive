@using DeepDive.ViewModels;
@model AllEquipmentViewData

@{
    string action = ViewBag.Action ?? string.Empty;

    string title = action switch
    {
        "BCD" => "BCD",
        "DivingSuits" => "Dykkerdragter",
        "Finns" => "Finner",
        "Mask_Snorkel" => "Maske & Snorkel",
        "RegulatorSet" => "RegulatorSæt",
        "Tank" => "Tank",
        _ => ""
    };
}

<h1>@title</h1>

<div class="row row-cols-2 row-cols-md-3">
    @foreach (var equipment in Model.bcds)
    {
        <a asp-controller="SpecificEquipment" asp-action="SpecificBCD" asp-route-id="@equipment.BCDId" class="text-decoration-none">
            <div class="col">
                <div class="card bg-b EquipmentCard">
                    <div class="card-body">
                        <img src="~/IMGs/Oceanic-Oceanpro-BCD-.png" alt="BCD Vest" />
                        <h6>Mærke: @equipment.Brand</h6>
                        <h6>Model: @equipment.Model</h6>
                        <h6>Størrelse: @equipment.Size</h6>
                        <h6>Pris pr. dag: @equipment.Price kr</h6>
                        <button class="btn btn-primary">Se Produkt</button>
                    </div>
                </div>
            </div>
        </a>
    }
</div>

<div class="row row-cols-2 row-cols-md-3">
    @foreach (var equipment in Model.divingSuits)
