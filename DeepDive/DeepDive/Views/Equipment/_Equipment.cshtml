@using DeepDive.ViewModels;
@model AllEquipmentViewData

@{
    string action = ViewBag.Action ?? string.Empty;
}

<div class="row row-cols-2 row-cols-md-3">
    @foreach (var equipment in Model.bcds)
    {
        <a asp-controller="SpecificEquipment" asp-action="SpecificBCD" asp-route-id="@equipment.BCDId" >
            <div class="col">
                <div class="card" style="width: 17rem; height: 22rem; margin: 0 0 2rem 0;">
                    <div class="card-body">
                        <img src="~/IMGs/Oceanic-Oceanpro-BCD-.png" alt="BCD Vest" style="width: 15rem; height: 10rem;" />
                        <h6>Mærke: @equipment.Brand</h6>
                        <h6>Model: @equipment.Model</h6>
                        <h6>Størrelse: @equipment.Size</h6>
                        <h6>Pris pr. dag: @equipment.Price kr</h6>
                        <button class="btn btn-primary">Se Produkt</button>
                    </div>
                </div>
            </div>
        </a>
    }
</div>

