@model DeepDive.Models.Finns
@using DeepDive.Enums

@{
    var isNew = Model.FinnsId == 0;
    ViewData["Title"] = isNew ? "Tilføj finner" : "Rediger finner";
}

<h1>@ViewData["Title"]</h1>

    <form asp-action="EditFinns" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="FinnsId" />
    <input type="hidden" asp-for="DateFrom" />
    <input type="hidden" asp-for="DateTo" />

    <div class="mb-3">
        <label asp-for="Brand"></label>
        <input asp-for="Brand" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Model"></label>
        <input asp-for="Model" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Størrelser</label>
        @foreach (var size in Enum.GetValues<EquipmentSize>())
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="Size" value="@size" id="size_@size"
                @(Model.Size.Contains(size) ? "checked" : "") />
                <label class="form-check-label" for="size_@size">@size</label>
            </div>
        }
    </div>

    <div class="mb-3">
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Gem</button>
    <a asp-action="Index" class="btn btn-secondary">Tilbage</a>
</form>
