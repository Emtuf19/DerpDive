@using DeepDive.Enums
@model DeepDive.ViewModels.AdminVM

@{
    ViewData["Title"] = "Admin";
}

<h1>Admin</h1>

<!--  links til hver sektion -->
<p>
    <a href="#bookinger" class="btn btn-sm btn-light">Bookinger</a>
    <a href="#bcd" class="btn btn-sm btn-light">BCD</a>
    <a href="#dragter" class="btn btn-sm btn-light">Dragter</a>
    <a href="#finner" class="btn btn-sm btn-light">Finner</a>
    <a href="#masker" class="btn btn-sm btn-light">Maske & snorkel</a>
    <a href="#regulatorer" class="btn btn-sm btn-light">Regulatorsæt</a>
    <a href="#tanke" class="btn btn-sm btn-light">Tanke</a>
    <a href="#pakker" class="btn btn-sm btn-light">Pakker</a>
</p>

<!-- ===================== BOOKINGER ===================== -->
<div class="admin-card">
    <h2 id="bookinger">Bookinger (@Model.Bookings.Count stk.)</h2>

    @foreach (var booking in Model.Bookings)
    {
        <div class="booking-card">

            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <strong>Booking #@booking.BookingId</strong>
                    <span>
                       | @(booking.ApplicationUser?.Email ?? "Ingen bruger")
                    </span>

                    @if (booking.BookingItems.Any())
                    {
                        <span >
                          |  @booking.BookingItems.Min(i => i.DateFrom).ToString("dd-MM-yyyy")
                           - @booking.BookingItems.Max(i => i.DateTo).ToString("dd-MM-yyyy")
                        </span>
                        <span >
                          | @booking.BookingItems.Count varer
                        </span>
                    }
                </div>

                <form asp-action="DeleteBooking" asp-route-id="@booking.BookingId" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Slet booking</button>
                </form>
            </div>

            <table class="table admin-table mb-0">
                <thead>
                    <tr>
                        <th>Vare-ID</th>
                        <th>Udstyr</th>
                        <th>Str.</th>
                        <th>Køn</th>
                        <th>Fra</th>
                        <th>Til</th>
                        <th class="num">Pris pr. dag</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in booking.BookingItems)
                    {

                        <tr>
                            <td>@item.EquipmentId</td>
                            <td>
                                @if (item.EquipmentType == EquipmentType.Package)
                                {
                                    @(Model.Equipment.Packages.FirstOrDefault(p => p.PackageId == item.EquipmentId)?.Title ?? "Pakke")
                                }
                                else
                                {
                                    @item.EquipmentType
                                }
                            </td>
                            <td>@(item.SelectedSize?.ToString() ?? "-")</td>
                            <td>@(item.SelectedGender?.ToString() ?? "-")</td>
                            <td>@item.DateFrom.ToString("dd-MM-yyyy")</td>
                            <td>@item.DateTo.ToString("dd-MM-yyyy")</td>
                            <td class="num">@item.Price kr.</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="EditBookingItem" asp-route-id="@item.BookingItemId">Rediger</a>
                                <form asp-action="DeleteBookingItem" asp-route-id="@item.BookingItemId"
                                      method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Slet vare</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ===================== BCD ===================== -->

<div class="admin-card">
<div class="d-flex justify-content-between align-items-center mt-4">
    <h2 id="bcd">BCD (@Model.Equipment.bcds.Count stk.) </h2>
        <a asp-action="AddBCD" class="btn btn-primary">Tilføj BCD</a>
</div>
<table class="table admin-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Brand</th>
            <th>Model</th>
            <th>Størrelser</th>
            <th class="num">Pris pr. dag</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bcd in Model.Equipment.bcds)
        {
            <tr>
                <td class ="col-id">@bcd.BCDId</td>
                <td>@bcd.Brand</td>
                <td>@bcd.Model</td>
                <td>@string.Join(", ", bcd.Size)</td>
                    <td class ="num">@bcd.Price kr.</td>
                <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="EditBCD" asp-route-id="@bcd.BCDId">Rediger</a>
                    <form asp-action="DeleteBCD" asp-route-id="@bcd.BCDId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Slet</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

