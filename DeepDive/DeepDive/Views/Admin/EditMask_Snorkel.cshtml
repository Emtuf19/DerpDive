@model DeepDive.Models.Mask_Snorkel
@{
    var isNew = Model.Mask_SnorkelId == 0;
    ViewData["Title"] = isNew ? "Tilføj maske / snorkel" : "Rediger maske / snorkel";
}

<h1>@ViewData["Title"]</h1>

    <form asp-action="EditMask_Snorkel" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="Mask_SnorkelId" />
    <input type="hidden" asp-for="DateFrom" />
    <input type="hidden" asp-for="DateTo" />

    <div class="mb-3">
        <label asp-for="Brand"></label>
        <input asp-for="Brand" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Model"></label>
        <input asp-for="Model" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Gem</button>
    <a asp-action="Index" class="btn btn-secondary">Tilbage</a>
</form>
