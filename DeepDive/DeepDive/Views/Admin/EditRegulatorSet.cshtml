@model DeepDive.Models.RegulatorSet

@{
    var isNew = Model.RegulatorSetId == 0;
    ViewData["Title"] = isNew ? "Tilføj regulatorsæt" : "Rediger regulatorsæt";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="EditRegulatorSet" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="RegulatorSetId" />
    <input type="hidden" asp-for="DateFrom" />
    <input type="hidden" asp-for="DateTo" />

    <div class="mb-3">
        <label asp-for="Brand"></label>
        <input asp-for="Brand" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FirstStep">1. trin</label>
        <input asp-for="FirstStep" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="SecondStep">2. trin</label>
        <input asp-for="SecondStep" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Octopus"></label>
        <input asp-for="Octopus" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Gem</button>
    <a asp-action="Index" class="btn btn-secondary">Tilbage</a>
</form>
