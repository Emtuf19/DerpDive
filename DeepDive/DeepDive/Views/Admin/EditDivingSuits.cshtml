@model DeepDive.Models.DivingSuits
@using DeepDive.Enums

@{
    var isNew = Model.DivingSuitsId == 0;
    ViewData["Title"] = isNew ? "Tilføj dykkerdragt" : "Rediger dykkerdragt";
}

<h1>@ViewData["Title"]</h1>

    <form asp-action="EditDivingSuits" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="DivingSuitsId" />
    <input type="hidden" asp-for="DateFrom" />
    <input type="hidden" asp-for="DateTo" />

    <div class="mb-3">
        <label asp-for="Brand"></label>
        <input asp-for="Brand" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Model"></label>
        <input asp-for="Model" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Type"></label>
        <input asp-for="Type" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Thickness">Tykkelse (mm)</label>
        <input asp-for="Thickness" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Størrelser</label>
        @foreach (var size in Enum.GetValues<EquipmentSize>())
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="Size" value="@size" id="size_@size"
                @(Model.Size.Contains(size) ? "checked" : "") />
                <label class="form-check-label" for="size_@size">@size</label>
            </div>
        }
    </div>

    <div class="mb-3">
        <label>Køn</label>
        @foreach (var gender in Enum.GetValues<EquipmentGender>())
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="Gender" value="@gender" id="gender_@gender"
                @(Model.Gender.Contains(gender) ? "checked" : "") />
                <label class="form-check-label" for="gender_@gender">@gender</label>
            </div>
        }
    </div>

    <div class="mb-3">
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Gem</button>
    <a asp-action="Index" class="btn btn-secondary">Tilbage</a>
</form>
