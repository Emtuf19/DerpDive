@{
    ViewData["Title"] = "Home Page";
}
@section Header {
<section id="BackgoundIMG">
    <img src="~/IMGs/Blog-Header-Diver-School-of-Fish.jpg" alt="Diver School of Fish"/>
        <p id="BackgoundIMG_Text">
            Velkommen til Dive Deep, professionel dykning og udlejning af dykkerudstyr. Vi tilbyder kurser og certificeringer for alle niveauer,
            fra begyndere til erfarne dykkere. Vores erfarne instruktører vil guide dig gennem hvert trin af din dykkerrejse,
            og vores topmoderne udstyr sikrer, at du har en sikker og behagelig oplevelse under vandet!
        </p>
</section>
}
<section>
    <h1>Udstyrs pakker</h1>
    <div class="row row-cols-2 g-3">
        @foreach (var packages in Model)
        {
            <div class="col">
                <div class="card mb-3 h-100 bg-b">
                    <div class="card-body align-bottom">
                        <h5 class="card-title">@packages.Title</h5>
                        <p class="card-text">@packages.Description</p>
                        <div class="card-buttons">
                            <a href="#" class="btn btn-primary">Se pakke</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

