@using DeepDive.ViewModels;
@model SpecificRegulatorSet;

<form method="post"
      asp-controller="SpecificEquipment"
      asp-action="SpecificRegulatorSet">

    <input type="hidden" asp-for="RegulatorSetId" />

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Brand"></label>
            <input asp-for="Brand" class="form-control" readonly />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="FirstStep"></label>
            <input asp-for="FirstStep" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="SecondStep"></label>
            <input asp-for="SecondStep" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Octopus"></label>
            <input asp-for="Octopus" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Price"></label>
            <input asp-for="Price" class="form-control" readonly />
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Vælg regulatorsæt
    </button>

</form>
