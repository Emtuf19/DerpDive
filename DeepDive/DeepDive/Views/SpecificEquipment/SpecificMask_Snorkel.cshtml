@using DeepDive.ViewModels;
@model SpecificMask_Snorkel;

<form method="post"
      class="product-form"
      asp-controller="SpecificEquipment"
      asp-action="SpecificMask_Snorkel">

    <input type="hidden" asp-for="Mask_SnorkelId" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Brand"></label>
            <input asp-for="Brand" class="form-control" readonly />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Model"></label>
            <input asp-for="Model" class="form-control" readonly />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label>Dato fra</label>
            <input asp-for="DateFrom" type="date" class="form-control" value="date" />
            <label>Dato til</label>
            <input asp-for="DateTo" type="date" class="form-control" value="date" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Price">Pris pr. dag</label>
            <input asp-for="Price" class="form-control" readonly />
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Tilføj til kurv
    </button>
    <div class="d-flex gap-2 mt-2">
        <a class="btn btn-ghost flex-fill" asp-controller="Equipment" asp-action="Category">
            Shop videre
        </a>
        <a class="btn btn-ghost flex-fill" asp-controller="Cart" asp-action="Index">
            Gå til kurv
        </a>
    </div>
</form>
