@using DeepDive.ViewModels;
@model SpecificBCD;

<form method="post"
     class="product-form"
      asp-controller="SpecificEquipment"
      asp-action="SpecificBCD">

    <input type="hidden" asp-for="BCDId" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <img src="~/IMGs/Oceanic-Oceanpro-BCD-.png" alt="@Model.Brand @Model.Model" class="product-image" />


    <div class="row mb-3">
        <div class="col">
            <label asp-for="Brand"></label>
            <input asp-for="Brand" class="form-control" readonly />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Model"></label>
            <input asp-for="Model" class="form-control" readonly />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label>Størrelse</label>
            <select asp-for="SelectedSize" class="form-control" required>
                <option value="">Vælg størrelse</option>

                @foreach (var size in Model.AvailableSizes)
                {
                    <option value="@size">@size</option>
                }
            </select>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label>Dato Fra</label>
            <input asp-for="DateFrom" type="date" class="form-control" value="date"/>
            <label>Dato Til</label>
            <input asp-for="DateTo" type="date" class="form-control" value="date" />
        </div>
    </div>


    <div class="row mb-3">
        <div class="col">
            <label asp-for="Price">Pris pr. dag</label>
            <input asp-for="Price" class="form-control" readonly />
        </div>
    </div>

    <button type="button" class="btn btn-primary" id="OpenPopUp">
        Tilføj til kurv
    </button>
    <dialog class="modal-dialog" id="ConfirmationModal">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bekræftelse</h5>
            </div>
            <div class="modal-body">
                <p>Din vare er blevet tilføjet til kurven</p>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-secondary" id="ClosePopUp">Ok</button>
            </div>
        </div>
    </dialog>
        @* <a class="btn btn-primary" asp-controller="Equipment" asp-action="Category"></a>
    <button type="submit" class="btn btn-primary">
        Tilføj til kurv
    </button> *@
    <div class="d-flex gap-2 mt-2">
    <a class="btn btn-ghost flex-fill" asp-controller="Equipment" asp-action="Category">
        Shop videre
    </a>
        <a class="btn btn-ghost flex-fill" asp-controller="Cart" asp-action="Index">
        Gå til kurv
    </a>
    </div>
</form>

<script>
        const PopUp = document.getElementById('ConfirmationModal');
        const openBtn = document.getElementById('OpenPopUp');
        const closeBtn = document.getElementById('ClosePopUp');

        openBtn.addEventListener('click', () => {
            PopUp.showModal();
        });

        closeBtn.addEventListener('click', () => {
            PopUp.close();
        });
</script>