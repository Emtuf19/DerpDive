@using DeepDive.ViewModels;
@model SpecificBCD;

<form method="post"
     class="product-form"
      asp-controller="SpecificEquipment"
      asp-action="SpecificBCD">
    <input type="hidden" asp-for="BCDId" />
    <input type="hidden" asp-for="Brand" />
    <input type="hidden" asp-for="Model" />
    <input type="hidden" asp-for="Price" />

    <div asp-validation-summary="All" class="text-danger"></div>
    @if (Model.ImageData != null && Model.ImageMimeType != null)
    {
        <img src="data:@Model.ImageMimeType;base64,@(Convert.ToBase64String(Model.ImageData))" alt="@Model.Brand @Model.Model" class="product-image" />
    }
    else
    {
        <img src="~/IMGs/Oceanic-Oceanpro-BCD-.png" alt="@Model.Brand @Model.Model" class="product-image" />
    }


    <div class="row mb-3">
        <div class="col">
            <label asp-for="Brand"></label>
            <p class="equipment-info">@Model.Brand</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Model"></label>
            <p class="equipment-info">@Model.Model</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label>Størrelse</label>
            <select asp-for="SelectedSize" class="form-control" required>
                <option value="">Vælg størrelse</option>

                @foreach (var size in Model.AvailableSizes)
                {
                    <option value="@size">@size</option>
                }
            </select>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label>Dato Fra</label>
            <input asp-for="DateFrom" type="date" class="form-control" value="date"/>
            <label>Dato Til</label>
            <input asp-for="DateTo" type="date" class="form-control" value="date" />
        </div>
    </div>


    <div class="row mb-3">
        <div class="col">
            <label asp-for="Price">Pris pr. dag</label>
            <p class="equipment-info">@Model.Price </p>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Tilføj til kurv
    </button>
    <dialog id="ConfirmationModal">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bekræftelse</h5>
            </div>
            <div class="modal-body">
                <p>Din vare er blevet tilføjet til kurven</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="ClosePopUp">Ok</button>
            </div>
        </div>
    </dialog>
    <div class="d-flex gap-2 mt-2">
    <a class="btn btn-ghost flex-fill" asp-controller="Equipment" asp-action="Category">
        Shop videre
    </a>
        <a class="btn btn-ghost flex-fill" asp-controller="Cart" asp-action="Index">
        Gå til kurv
    </a>
    </div>
</form>

      @*  Vi submitter først produktet og hvis det lykkedes kommer der pop up, hvis ikke kommer fejlmeddelelsen. Det gør vi via TempData. *@
<script>
    const closeBtn = document.getElementById('ClosePopUp');
    closeBtn.addEventListener('click', () => {
        document.getElementById('ConfirmationModal').close();
    });

</script>

@if (TempData["ItemAdded"] != null)
{
    <script>
        document.getElementById('ConfirmationModal').showModal();
    </script>
}
