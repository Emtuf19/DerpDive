@using DeepDive.ViewModels;
@using DeepDive.Enums;
@model SpecificDivingSuitVM;

<form method="post"
      asp-controller="SpecificEquipment"
      asp-action="SpecificDivingSuits">

    <input type="hidden" asp-for="DivingSuitsId" />

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Brand"></label>
            <input asp-for="Brand" class="form-control" readonly />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Model"></label>
            <input asp-for="Model" class="form-control" readonly />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Type"></label>
            <input asp-for="Type" class="form-control" readonly />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Thickness"></label>
            <input asp-for="Thickness" class="form-control" readonly />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <select asp-for="SelectedGender" required>
                <option value="">Vælg køn</option>

                @foreach (var gender in Model.AvailableGenders)
                {
                    <option value="@gender">@gender</option>
                }
            </select>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <select asp-for="SelectedSize" required>
                <option value="">Vælg størrelse</option>

                @foreach (var size in Model.AvailableSizes)
                {
                    <option value="@size">@size</option>
                }
            </select>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <option value="">Dato Fra</option>
            <input type="date" name="Date" value="date" />
            <option value="">Dato til</option>
            <input type="date" name="Date" value="date" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Price"></label>
            <input asp-for="Price" class="form-control" readonly />
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Vælg dragt
    </button>
    <a class="btn btn-secondary" asp-controller="Equipment" asp-action="Category">
        Shop videre
    </a>
    <a class="btn btn-secondary" asp-controller="Cart" asp-action="Index">
        Gå til kurv
    </a>
</form>