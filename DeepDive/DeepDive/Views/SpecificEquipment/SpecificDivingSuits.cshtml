@using DeepDive.ViewModels;
@model SpecificDivingSuitVM;

<form method="post"
      asp-controller="SpecificEquipment"
      asp-action="SpecificDivingSuits">

    <input type="hidden" asp-for="DivingSuitsId" />

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Brand"></label>
            <input asp-for="Brand" class="form-control" readonly />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Model"></label>
            <input asp-for="Model" class="form-control" readonly />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Type"></label>
            <input asp-for="Type" class="form-control" readonly />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Thickness"></label>
            <input asp-for="Thickness" class="form-control" readonly />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Gender"></label>
            <input asp-for="Gender" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Size"></label>
            <input asp-for="Size" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Price"></label>
            <input asp-for="Price" class="form-control" readonly />
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Vælg dragt
    </button>

</form>