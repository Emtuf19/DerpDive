@using DeepDive.ViewModels;
@model SpecificTank;

<form method="post"
      asp-controller="SpecificEquipment"
      asp-action="SpecificTank">

    <input type="hidden" asp-for="TankId" />

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Brand"></label>
            <input asp-for="Brand" class="form-control" readonly />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Volumen"></label>
            <input asp-for="Volumen" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Price"></label>
            <input asp-for="Price" class="form-control" readonly />
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Vælg tank
    </button>

</form>
