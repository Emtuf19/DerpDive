@using DeepDive.ViewModels;
@model SpecificTank;

<form method="post"
      class="product-form"
      asp-controller="SpecificEquipment"
      asp-action="SpecificTank">

    <input type="hidden" asp-for="TankId" />
    <input type="hidden" asp-for="Brand" />
    <input type="hidden" asp-for="Volumen" />
    <input type="hidden" asp-for="Price" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <img src="~/IMGs/Tank.webp" alt="@Model.Brand" class="product-image" />

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Brand"></label>
            <p class="equipment-info">@Model.Brand</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Volumen"></label>
            <p class="equipment-info">@Model.Volumen</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label>Dato fra</label>
            <input asp-for="DateFrom" type="date" class="form-control" value="date" />
            <label>Dato til</label>
            <input asp-for="DateTo" type="date" class="form-control" value="date" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Price">Pris pr. dag</label>
            <p class="equipment-info">@Model.Price</p>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Tilføj til kurv
    </button>
    <dialog id="ConfirmationModal">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bekræftelse</h5>
            </div>
            <div class="modal-body">
                <p>Din vare er blevet tilføjet til kurven</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="ClosePopUp">Ok</button>
            </div>
        </div>
    </dialog>
    <div class="d-flex gap-2 mt-2">
        <a class="btn btn-ghost flex-fill" asp-controller="Equipment" asp-action="Category">
            Shop videre
        </a>
        <a class="btn btn-ghost flex-fill" asp-controller="Cart" asp-action="Index">
            Gå til kurv
        </a>
    </div>
</form>

@*  Vi submitter først produktet og hvis det lykkedes kommer der pop up, hvis ikke kommer fejlmeddelelsen. Det gør vi via TempData. *@
<script>
    const closeBtn = document.getElementById('ClosePopUp');
    closeBtn.addEventListener('click', () => {
        document.getElementById('ConfirmationModal').close();
    });
</script>

@if (TempData["ItemAdded"] != null)
{
    <script>
        document.getElementById('ConfirmationModal').showModal();
    </script>
}
