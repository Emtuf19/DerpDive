@using DeepDive.ViewModels;
@using DeepDive.Enums;
@model CartVM

<div class="container py-4">
    <h1>Din kurv</h1>

    @if (!Model.Items.Any())
    {
        <div class="empty-cart">
            <p>Din kurv er tom.</p>
            <a class="btn btn-primary" asp-controller="Equipment" asp-action="Category">
                Se vores udstyr
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">

            @* Venstre: varer *@
            <div class="col-lg-8">
                @foreach (var item in Model.Items)
                {
                    <div class="cart-item">
                        <div class="cart-item-header">
                            <h5>@item.EquipmentType - @item.Brand</h5>
                            <span class="cart-item-price">@item.Price kr. pr. dag</span>
                        </div>

                        <div class="cart-item-details">
                            @if (item.EquipmentType == EquipmentType.DivingSuits)
                            {
                                <span>@item.Model</span>
                                <span>@item.Type · @item.Thickness mm</span>
                                <span>@item.SelectedGender · Størrelse: @item.SelectedSize</span>
                            }
                            else if (item.EquipmentType == EquipmentType.BCD
                                  || item.EquipmentType == EquipmentType.Finns)
                            {
                                <span>@item.Model</span>
                                <span>Størrelse: @item.SelectedSize</span>
                            }
                            else if (item.EquipmentType == EquipmentType.Mask_Snorkel)
                            {
                                <span>@item.Model</span>
                            }
                            else if (item.EquipmentType == EquipmentType.RegulatorSet)
                            {
                                <span>1. trin: @item.FirstStep</span>
                                <span>2. trin: @item.SecondStep</span>
                                <span>Octopus: @item.Octopus</span>
                            }
                            else if (item.EquipmentType == EquipmentType.Tank)
                            {
                                <span>@item.Volumen L</span>
                            }
                        </div>

                        <div class="cart-item-footer">
                            <span class="cart-dates">
                               Fra d. @item.DateFrom.ToString("dd/MM/yyyy") til d. @item.DateTo.ToString("dd/MM/yyyy")
                                (@((item.DateTo - item.DateFrom).Days + 1) dage)
                            </span>

                            <form asp-controller="Cart" asp-action="Remove" method="post" class="d-inline">
                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                <button type="submit" class="btn-remove">Fjern</button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            @* Højre: opsummering *@
            <div class="col-lg-4">
                <div class="cart-summary">
                    <h5>Opsummering</h5>


                    <div class="summary-row">
                        <span>Antal varer</span>
                        <span>@Model.Items.Count</span>

                    </div>

                    <hr />

                    <div class="summary-row summary-total">
                        <span>Total</span>
                        <span>@Model.TotalPrice kr.</span>
                    </div>

                    <a class="btn btn-checkout" asp-controller="Cart" asp-action="Checkout">
                        Gå til betaling
                    </a>

                    <a class="btn btn-ghost-dark" asp-controller="Equipment" asp-action="Category">
                        Shop videre
                    </a>
                </div>
            </div>

        </div>
    }
</div>